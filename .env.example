# 复制为 .env.local，然后填入你自己的 Key。不要把 .env.local 发给别人。
TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.io
DEYO_API_KEY=
DEYO_CLI=
DEYO_ENABLED=1
STRICT_DEYO_PARSE=0
DEYO_TIMEOUT=1800
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
LOW_COST_TEXT_MODEL=deepseek-chat
LLM_FALLBACK_MODELS=deepseek-chat
LLM_FALLBACK_ON_ERROR=0
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
MAX_KEYFRAMES=8
VISUAL_OCR_ENABLED=1
OCR_MAX_KEYFRAMES=12
CRV_ENABLED=1
REAL_VIDEO_FIRST=1
CRV_FPS_FLOOR=5
STRICT_TIKHUB_PARSE=0
STRICT_LLM=0

# 飞书 OAuth + 云空间上传
H5_BASE_URL=http://127.0.0.1:8088
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://127.0.0.1:8787/api/oauth/feishu/callback
FEISHU_SCOPE=drive:file:upload
FEISHU_PARENT_TYPE=explorer
FEISHU_PARENT_NODE=

# 微信支付 API v3（小程序/App）
# 免费内测保持 0；取得合规经营主体并完成商户配置后再改为 1。
PAYMENT_ENABLED=0
FREE_BETA_QUOTA=20
# 私钥和平台公钥既可以填 PEM 文件绝对路径，也可以直接填 PEM（换行写成 \n）。
WECHAT_PAY_MCH_ID=
WECHAT_PAY_CERT_SERIAL=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_SERIAL=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://你的API域名/api/payments/wechat/notify
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_APP_ID=
